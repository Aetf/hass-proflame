{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":automergeMinor", "group:allNonMajor"],
  "labels": ["renovate"],
  "automergeStrategy": "squash",
  "customManagers": [
    {
      "description": "The protocol library pin in the integration manifest",
      "customType": "regex",
      "managerFilePatterns": ["/manifest\\.json$/"],
      "matchStrings": ["\"(?<depName>proflame)==(?<currentValue>[0-9][^\"]*)\""],
      "datasourceTemplate": "pypi"
    }
  ],
  "packageRules": [
    {
      "description": "Minor bumps of 0.x dependencies are semver-breaking in practice",
      "automerge": false,
      "matchCurrentVersion": "< 1.0.0",
      "matchUpdateTypes": ["minor"]
    },
    {
      "description": "Our own protocol library: CI (hassfest + tests) gates it, automerge every update",
      "matchDepNames": ["proflame"],
      "automerge": true
    }
  ]
}
